---
/*
 * A programme's own page.
 *
 * The design has no per-programme page — its four cards linked to "#" — so this
 * assembles one from what the design states about each programme, using the same
 * sections in the same order as the homepage: the identity, the competencies
 * as full chips rather than truncated ones, the guild, the wing's laboratory,
 * and the enrolment route. Every word is the design's own; nothing about the
 * curriculum is described here, because the design does not describe any.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { ENROLL_URL, IMAGES } from '../../consts';
import Icon from '../../components/Icon.astro';
import ProgramMark from '../../components/ProgramMark.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
	const programs = await getCollection('programs');
	return programs.map((program) => ({
		params: { slug: program.data.slug },
		props: { program },
	}));
}) satisfies GetStaticPaths;

const { program } = Astro.props;
const { name, overline, description, competencies, guild, badgeLabel, mark, wing } = program.data;
const image = IMAGES.wings[wing.image];
---

<Base title={name} description={description}>
	<!-- Identity. -->
	<section class="w-full bg-midnight py-space-xl text-white">
		<div class="mx-auto max-w-7xl px-space-gutter">
			<div class="grid grid-cols-1 items-center gap-space-xl md:grid-cols-2">
				<div>
					<nav aria-label="Breadcrumb" class="mb-space-md">
						<ol class="flex items-center gap-1 text-label-md text-white/60">
							<li>
								<a href="/programs" class="transition-colors hover:text-copper">
									Programs Offered
								</a>
							</li>
							<li aria-hidden="true" class="text-white/30">
								/
							</li>
							<li class="text-amberprint" aria-current="page">
								{name}
							</li>
						</ol>
					</nav>

					<div class="mb-space-md">
						<ProgramMark mark={mark} label={badgeLabel} surface="bg-white/10" />
					</div>

					<span class="block text-label-badge font-bold uppercase tracking-widest text-amberprint">
						{overline}
					</span>
					<h1 class="mt-2 font-serif text-headline-lg-mobile font-bold text-white md:text-headline-lg">
						{name}
					</h1>
					<p class="mt-3 max-w-2xl text-body-lg leading-relaxed text-white/85">{description}</p>
				</div>

				<figure class="overflow-hidden rounded-xl bg-navy/80">
					<RemoteImage
						src={image.src}
						alt={image.alt}
						width={800}
						height={600}
						class="aspect-[4/3] w-full object-cover"
					/>
					<figcaption class="p-space-md">
						<span class="block text-headline-sm font-bold text-white">{wing.title}</span>
						<span class="mt-1 block text-label-md text-copper">{wing.lab}</span>
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- Competencies and guild. -->
	<section class="w-full bg-canvas py-space-xl">
		<div class="mx-auto max-w-7xl px-space-gutter">
			<div class="grid grid-cols-1 gap-space-xl md:grid-cols-2">
				<div>
					<SectionHeading>
						<span slot="eyebrow">Curriculum Focus</span>
						<h2 class="font-serif text-headline-md font-bold text-navy">Key Competencies</h2>
					</SectionHeading>
					<ul class="mt-space-md grid grid-cols-1 gap-2 sm:grid-cols-2">
						{competencies.map((item) => (
							<li class="flex items-center gap-space-sm rounded bg-subtle px-space-md py-space-sm text-body-md text-navy">
								<Icon name="check_circle" size="18px" class="shrink-0 text-copper" />
								{item}
							</li>
						))}
					</ul>
				</div>

				<div>
					<SectionHeading>
						<span slot="eyebrow">Student Organisation</span>
						<h2 class="font-serif text-headline-md font-bold text-navy">Student Guild</h2>
					</SectionHeading>
					<div class="mt-space-md rounded-lg bg-subtle p-space-lg">
						<p class="text-body-md text-navy">{guild}</p>
						<p class="mt-2 text-body-sm text-brand-700">
							The {name} guild is the {name} programme's own student organisation.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Laboratory. -->
	<section class="w-full bg-subtle py-space-xl">
		<div class="mx-auto max-w-7xl px-space-gutter">
			<SectionHeading>
				<span slot="eyebrow">Laboratory</span>
				<h2 class="font-serif text-headline-lg-mobile font-bold text-navy md:text-headline-lg">
					{wing.lab}
				</h2>
				<p slot="lead" class="mt-2 max-w-2xl text-body-md text-brand-700">
					{wing.description}
				</p>
			</SectionHeading>

			<div class="overflow-hidden rounded-xl bg-canvas shadow-elev-2">
				<RemoteImage
					src={image.src}
					alt={image.alt}
					width={1280}
					height={720}
					class="aspect-[16/9] w-full object-cover"
				/>
			</div>
		</div>
	</section>

	<!-- Enrol. -->
	<section class="w-full bg-navy py-space-lg text-white">
		<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-space-md px-space-gutter md:flex-row">
			<p class="text-body-md text-white/85">Ready to take the next step in {name}?</p>
			<div class="flex shrink-0 flex-wrap items-center gap-space-sm">
				<a
					href="/contact-and-inquiries"
					class="rounded bg-white/10 px-space-md py-2 text-label-md font-bold text-white transition-colors hover:bg-white/20"
				>
					Send an Inquiry
				</a>
				<a
					href={ENROLL_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-space-xs rounded bg-copper px-space-lg py-2.5 text-label-md font-bold uppercase tracking-wider text-white transition-colors hover:bg-accent-600"
				>
					<Icon name="how_to_reg" size="16px" />
					Enroll Now
				</a>
			</div>
		</div>
	</section>
</Base>
