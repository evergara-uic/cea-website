---
/*
 * The site's icon set.
 *
 * The design's prototype draws its icons with Material Symbols. Rather than
 * copy those outlines, each glyph here is hand-drawn on the same 24x24 grid in
 * the same stroked, round-capped register the rest of the design system uses, so
 * the icons read as part of this site's own drafting language and the set stays
 * dependency-free.
 *
 * Every glyph is a single path set on `currentColor`, so an icon takes the
 * colour of the text it sits in and needs no variant.
 */
interface Props {
	name: IconName;
	/** Any Tailwind size class. Defaults to 1em so an icon matches its label. */
	size?: string;
	/** Provide a label to expose the icon to assistive technology. */
	label?: string;
	/** Extra classes, for the handful of icons that need to be positioned. */
	class?: string;
	/** Decorative by default: hidden from the accessibility tree. */
}

export type IconName = keyof typeof PATHS;

const PATHS = {
	mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="M3 6.5 12 13l9-6.5"/>',
	call: '<path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z"/>',
	'location-on':
		'<path d="M12 21.5s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"/><circle cx="12" cy="10.5" r="2.5"/>',
	lock: '<rect x="4.5" y="10" width="15" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
	school:
		'<path d="M2.5 8.5 12 4l9.5 4.5L12 13 2.5 8.5Z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/><path d="M21.5 8.5V14"/>',
	person: '<circle cx="12" cy="8" r="3.5"/><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"/>',
	expand_more: '<path d="m6 9.5 6 6 6-6"/>',
	how_to_reg:
		'<path d="M8 4.5H6.5a2 2 0 0 0-2 2V19a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-2"/><rect x="8.5" y="2.5" width="7" height="4" rx="1.2"/><path d="m9 13.5 2.5 2.5 4.5-5"/>',
	arrow_forward: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
	menu_book:
		'<path d="M12 6.5S10 4.5 3.5 4.5v13C10 17.5 12 19.5 12 19.5Z"/><path d="M12 6.5s2-2 8.5-2v13c-6.5 0-8.5 2-8.5 2Z"/><path d="M12 6.5v13"/>',
	campaign:
		'<path d="M4 9.5v5h3l7 4.5v-14L7 9.5H4Z"/><path d="M17.5 8.5a5 5 0 0 1 0 7"/><path d="M7 14.5v5.5"/>',
	open_in_new:
		'<path d="M14 4.5h5.5V10"/><path d="M19.5 4.5 11 13"/><path d="M18 14v4.5a2 2 0 0 1-2 2H5.5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2H10"/>',
	verified_user:
		'<path d="M12 2.5 4.5 5.5v6c0 4.5 3.2 8.7 7.5 10 4.3-1.3 7.5-5.5 7.5-10v-6L12 2.5Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
	precision_manufacturing:
		'<circle cx="12" cy="12" r="3"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.2 5.2l2.1 2.1M16.7 16.7l2.1 2.1M18.8 5.2l-2.1 2.1M7.3 16.7l-2.1 2.1"/>',
	military_tech: '<circle cx="12" cy="9" r="5.5"/><path d="m8.5 13.5-2 8 5.5-2.5 5.5 2.5-2-8"/>',
	rocket_launch:
		'<path d="M13.5 3.5c3 0 7 4 7 7 0 0-1.5 3.5-5 5.5L9.5 10c2-3.5 4-6.5 4-6.5Z"/><circle cx="14.5" cy="9" r="1.8"/><path d="M8 13 5 16l3 1 1 3 3-3"/><path d="M6 15.5 3.5 19"/>',
	domain_verification:
		'<path d="M12 2.5 4.5 5.5v6c0 4.5 3.2 8.7 7.5 10 4.3-1.3 7.5-5.5 7.5-10v-6L12 2.5Z"/><path d="M9 12h6"/>',
	send: '<path d="M21 3 3 10.5l7 3 3 7L21 3Z"/><path d="m10 13.5 4-4"/>',
	check_circle: '<circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9.5"/>',
	shield: '<path d="M12 2.5 4.5 5.5v6c0 4.5 3.2 8.7 7.5 10 4.3-1.3 7.5-5.5 7.5-10v-6L12 2.5Z"/>',
	'thumb-up':
		'<path d="M7 10.5h2.5v9H7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z"/><path d="M9.5 10.5 13 3.2a2 2 0 0 1 2.4 2.3L14.5 9.5h4.6a2 2 0 0 1 1.9 2.6l-1.6 5.6a2 2 0 0 1-1.9 1.4H9.5"/>',
	language:
		'<path d="M3 6h10M8 3.5V6"/><path d="M11 6c0 4-3.5 7.5-8 8.5"/><path d="M6 11c1 2.5 3.5 4 6.5 4.2"/><path d="m12 20.5 4-9 4 9"/><path d="M13.5 17.5h5"/>',
	near_me: '<path d="m20.5 3.5-7.5 17-2.5-7-7-2.5 17-7.5Z"/>',
	chevron_right: '<path d="m9.5 5.5 6.5 6.5-6.5 6.5"/>',
	apartment:
		'<path d="M4 21.5V4.5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v17"/><path d="M14 9.5h5a1 1 0 0 1 1 1v11"/><path d="M2.5 21.5h19"/><path d="M7 7.5h1M11 7.5h1M7 11.5h1M11 11.5h1M7 15.5h1M11 15.5h1M17 13.5h.01M17 17.5h.01"/>',
	public:
		'<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c-2.5 3-2.5 15 0 18"/><path d="M12 3c2.5 3 2.5 15 0 18"/>',
	menu: '<path d="M3.5 7h17M3.5 12h17M3.5 17h17"/>',
	close: '<path d="m6 6 12 12M18 6 6 18"/>',

	/*
	 * The set below was added with the Academic Programs and Faculty Directory
	 * screens. They follow the same 24x24 stroked register as the rest, and each
	 * one is drawn to stand in for a Material Symbols glyph the design used.
	 */

	/* Breadcrumb. */
	home: '<path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M9.5 20v-6h5v6"/>',
	/* The department quick-filter row. */
	filter_list:
		'<path d="M3.5 7h5M12 7h8.5M3.5 17h8.5M15.5 17h5"/><circle cx="10" cy="7" r="2"/><circle cx="13.5" cy="17" r="2"/>',
	/* A drawing board, standing in for an architect with no photograph. */
	draw: '<circle cx="8" cy="5" r="2"/><path d="m8 7-1.5 9 6 4 2-4"/><path d="m6.5 16 9-3.5"/><path d="m12.5 20 2.5 1.5"/>',
	/* Curriculum PDF, and the jump link to the comparison table. */
	download: '<path d="M12 3.5v11"/><path d="m7.5 10 4.5 4.5 4.5-4.5"/><path d="M4 18.5v2h16v-2"/>',
	compare:
		'<path d="M3.5 5.5h6v13h-6z"/><path d="M14.5 5.5h6v13h-6z"/><path d="M9.5 9.5h5M9.5 14.5h5"/>',
	/* Play. The video facade's button. Stroked rather than filled, so it sits
	   in the same register as the rest of the set instead of reading as a
	   borrowed media control. */
	play: '<path d="M9 5.6v12.8l10-6.4z"/>',
	/* Executive Leadership. */
	stars: '<path d="m12 3.5 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8-4.2-4.1 5.9-.9Z"/>',
	/* Office hours. */
	schedule: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
	/* The advisement band. */
	headset_mic:
		'<path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2"/><path d="M4.5 13.5h1.5a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H5.5a1 1 0 0 1-1-1Z"/><path d="M19.5 13.5H18a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h.5a1 1 0 0 0 1-1Z"/><path d="M19.5 18.5v.5a2 2 0 0 1-2 2H13"/>',
	/* Department banners. */
	architecture:
		'<path d="M12 2.5 21.5 9H2.5Z"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-6h5v6"/>',
	layers:
		'<path d="m12 2.5 9 4.5-9 4.5-9-4.5Z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
	memory:
		'<rect x="6.5" y="6.5" width="11" height="11" rx="1.5"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9.5 3.5v3M14.5 3.5v3M9.5 17.5v3M14.5 17.5v3M3.5 9.5h3M3.5 14.5h3M17.5 9.5h3M17.5 14.5h3"/>',
	cell_tower:
		'<path d="M12 9.5v12"/><path d="M8.5 21.5h7"/><path d="m9.5 5.5 2.5-3 2.5 3"/><path d="M5.5 11.5a9 9 0 0 1 13 0"/><path d="M8 14.5a5.5 5.5 0 0 1 8 0"/><circle cx="12" cy="17.5" r="1.5"/>',
	/* The accreditation band. */
	award: '<circle cx="12" cy="9" r="5.5"/><path d="m8.5 13.5-1.5 8 5-2.5 5 2.5-1.5-8"/>',
	/*
	 * Credential kinds. These four carry the meaning of a faculty member's
	 * entries, so they are chosen by the kind in the data rather than written
	 * per person: see the `kind` field in src/content/faculty.json.
	 */
	verified:
		'<path d="M12 2.5 14 5l3.2-.4.6 3.2L20 10l-2.2 2.2.4 3.2-3.2.6L12 19l-3-3-3.2-.6.4-3.2L4 10l2.2-2.2-.6-3.2L10 5Z"/><path d="m9 11.5 2 2 4-4"/>',
	badge:
		'<rect x="3.5" y="6.5" width="17" height="13" rx="2"/><path d="M7.5 6.5V5a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v1.5"/><path d="M8 12h8"/>',
	workspace_premium:
		'<circle cx="12" cy="9" r="5.5"/><path d="m9.5 8.5 1.8 1.8L15 6.5"/><path d="M8 13.5 6.5 21.5 12 19l5.5 2.5L16 13.5"/>',
	briefcase:
		'<rect x="3" y="7.5" width="18" height="12" rx="2"/><path d="M9 7.5V6a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 6v1.5"/><path d="M3 12.5h18"/>',

	/*
	 * The set below came in with the Events & Retreats screen. Same grid, same
	 * register; each stands in for a Material Symbols glyph the design used.
	 */

	/* The screen's faith overline, and the ministry link beneath it. */
	church:
		'<path d="M12 2.5v4.2"/><path d="M10 4.6h4"/><path d="M12 6.7 6.5 10.4v11.1h11V10.4Z"/><path d="M10 21.5V16a2 2 0 0 1 4 0v5.5"/>',
	auto_stories:
		'<path d="M4.5 4.5h13a2 2 0 0 1 2 2v14H6.5a2 2 0 0 1-2-2Z"/><path d="M8.5 4.5v16"/><path d="M12 8h4M12 11.5h4"/>',
	/* The one distinguishing the teardrop from `location-on`'s shouldered pin. */
	pin_drop:
		'<path d="M12 2.5c3.9 0 7 3.3 7 7.4 0 4.9-7 12-7 12s-7-7.1-7-12c0-4.1 3.1-7.4 7-7.4Z"/><circle cx="12" cy="9.6" r="2.2"/>',
	calendar_month:
		'<rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 2.5v4M16 2.5v4"/><path d="M7.5 13.5h1.5M11 13.5h1.5M14.5 13.5h1.5M7.5 17h1.5M11 17h1.5"/>',
	/* Registration, as an identification badge rather than a clipboard. */
	app_registration:
		'<rect x="3.5" y="5.5" width="17" height="15" rx="2"/><path d="M8.5 5.5V4a1.5 1.5 0 0 1 1.5-1.5h4A1.5 1.5 0 0 1 15.5 4v1.5"/><circle cx="12" cy="12" r="2.4"/><path d="M7.8 18.2a4.6 4.6 0 0 1 8.4 0"/>',
	/* The sports fest. */
	sports_soccer:
		'<circle cx="12" cy="12" r="9"/><path d="m12 7.8 4.1 3-1.6 4.8h-5L8 10.8Z"/><path d="M12 3v4.8M20.8 9l-4.7 1.8M17.5 19.6l-3-4.8M6.5 19.6l3-4.8M3.2 9l4.8 1.8"/>',
	trophy:
		'<path d="M7 4.5h10v5a5 5 0 0 1-10 0Z"/><path d="M7 6H4.5v1.5A3.5 3.5 0 0 0 8 11"/><path d="M17 6h2.5v1.5A3.5 3.5 0 0 1 16 11"/><path d="M12 14.5V18M8.5 20.5h7"/>',
	group_add:
		'<circle cx="9" cy="7.5" r="3"/><path d="M3 19.5a6 6 0 0 1 12 0"/><path d="M18.5 7.5v7M15 11h7"/>',
	/* A measuring rule, for the guidelines and schedule documents. */
	rule: '<rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10.5 8v4M14.5 8v3M18 8v4"/>',
	volunteer_activism:
		'<path d="M12 3.5s-4 2.5-4 5.1a4 4 0 0 0 8 0c0-2.6-4-5.1-4-5.1Z"/><path d="M3.5 14c2 1.5 3.6 1.5 5.1.5 1.5-1 2.6 0 3.4 1"/><path d="M20.5 14c-2 1.5-3.6 1.5-5.1.5-1.5-1-2.6 0-3.4 1"/><path d="M8 18h8"/>',
	description: '<path d="M6 3.5h8l4 4v13H6Z"/><path d="M14 3.5v4h4"/><path d="M9 12.5h6M9 16h6"/>',
	diversity_3:
		'<circle cx="12" cy="6.5" r="2.5"/><circle cx="4.8" cy="9.5" r="2"/><circle cx="19.2" cy="9.5" r="2"/><path d="M7.4 19.5a4.6 4.6 0 0 1 9.2 0"/><path d="M1.4 19.5a3.6 3.6 0 0 1 4.6-2.6M22.6 19.5a3.6 3.6 0 0 0-4.6-2.6"/>',
	account_tree:
		'<rect x="8.5" y="2.5" width="7" height="5" rx="1"/><rect x="2.5" y="16.5" width="6" height="5" rx="1"/><rect x="15.5" y="16.5" width="6" height="5" rx="1"/><path d="M12 7.5v4.5M5.5 16.5V12h13v4.5"/>',
	search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.4 15.4 5.1 5.1"/>',
	account_circle:
		'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="9.8" r="2.7"/><path d="M6.3 18.6a6.8 6.8 0 0 1 11.4 0"/>',
	shield_with_heart:
		'<path d="M12 2.5 4.5 5.5v6c0 4.5 3.2 8.7 7.5 10 4.3-1.3 7.5-5.5 7.5-10v-6L12 2.5Z"/><path d="M12 9.8s-2.4 1.5-2.4 3a2.4 2.4 0 0 0 4.8 0c0-1.5-2.4-3-2.4-3Z"/>',
	format_quote:
		'<path d="M10 5c-3.5 1.8-5.5 4.8-5.5 8.5V19H10v-5.5H6.8c.2-2 1.2-3.6 3.2-4.6Z"/><path d="M20 5c-3.5 1.8-5.5 4.8-5.5 8.5V19h5.5v-5.5h-3.2c.2-2 1.2-3.6 3.2-4.6Z"/>',
	/* Two parties meeting — the design's word is a handshake, the meaning is
	   an agreement between the College and a community. */
	handshake:
		'<path d="M2.5 8.5h4L11 12"/><path d="M21.5 8.5h-4L13 12"/><path d="M2.5 8.5V13A1.5 1.5 0 0 0 4 14.5h1"/><path d="M21.5 8.5V13a1.5 1.5 0 0 1-1.5 1.5H19"/><path d="m9 13 2.5 2.5a1.4 1.4 0 0 0 2 0l1-1"/>',
} as const satisfies Record<string, string>;

const { name, size = '1em', label, class: className } = Astro.props;

const decorative = label === undefined;
const body = PATHS[name];
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={decorative ? 'true' : undefined}
	role={decorative ? undefined : 'img'}
	aria-label={label}
	class={className ?? 'shrink-0'}
	set:html={body}
/>
