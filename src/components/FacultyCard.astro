---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { credentialIcon } from './credential-icon';

/*
 * One member of the faculty on the Our Pride directory.
 *
 * The design draws a photograph where it has one and a drafting-board monogram
 * where it does not, and the only two people it had photographs of were the
 * Dean and the Architecture programme coordinator — both invented. The other
 * thirteen got the monogram, so fourteen real faculty were represented on this
 * site by an icon while two fictional people stood in for the roles.
 *
 * All sixteen are the College's own photographs now, supplied as files and
 * processed by `scripts/build-faculty-portraits.mjs` into 256px WebPs. Nothing
 * on this card is generated. The monogram is still here for anyone added to
 * `faculty.json` without a photograph, because that is what the design does and
 * it is a better answer than an invented face.
 *
 * The alt text is empty. The name is set in a heading directly beside the
 * photograph, so naming the person again would only make a screen reader say
 * it twice — the redundant-alt case, where `alt=""` is the correct answer and
 * any other value is the wrong one. The card is no less usable without it.
 *
 * The glyph beside each credential comes from the credential's `kind` rather
 * than being written per entry, so editing somebody's record cannot end up
 * pointing a mortarboard at a licence. The map itself is in
 * `credential-icon.ts`, shared with the coordinator card, and keyed on the
 * schema's own `CREDENTIAL_KINDS` so the two cannot fall out of step.
 */
interface Props {
	person: CollectionEntry<'faculty'>;
}

const { person } = Astro.props;
const d = person.data;

/** Every generated portrait, keyed by the roster id it belongs to. */
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/faculty/*.webp', {
	eager: true,
});

const portrait = d.portrait ? portraits[`../assets/faculty/${d.portrait}.webp`]?.default : undefined;

if (d.portrait && !portrait) {
	console.warn(`[faculty] "${d.id}" names a portrait "${d.portrait}" that was not generated`);
}
---

<article class="card p-space-md">
	<div class="space-y-space-sm">
		<div class="flex items-start justify-between gap-space-sm">
			{portrait ? (
				<picture class="portrait-frame size-16 shrink-0">
					<img
						src={portrait.src}
						alt=""
						width={portrait.width}
						height={portrait.height}
						loading="lazy"
						decoding="async"
						class="size-full object-cover object-top"
					/>
				</picture>
			) : (
				<span
					class="flex size-16 shrink-0 items-center justify-center rounded-xl border border-grid bg-brand-100 text-navy"
					aria-hidden="true"
				>
					<Icon name="draw" size="32px" />
				</span>
			)}
			<span
				class:list={[
					'rounded px-2 py-0.5 text-label-badge font-bold uppercase',
					d.badgeTone === 'copper' ? 'bg-copper/10 text-copper' : 'bg-brand-200 text-navy',
				]}
			>
				{d.badge}
			</span>
		</div>

		<div>
			{d.focus && (
				<span class="text-label-badge font-bold uppercase tracking-wider text-copper">
					{d.focus}
				</span>
			)}
			<h3 class="text-headline-sm font-bold leading-snug text-navy">{d.name}</h3>
			<p class="mt-0.5 text-label-md font-semibold text-brand-700">{d.role}</p>
		</div>

		{d.credentials.length > 0 && (
			<ul class="space-y-1.5 border-t border-grid/60 pt-2 text-body-sm text-brand-700">
				{d.credentials.map((credential) => (
					<li class="flex items-start gap-1.5">
						<Icon
							name={credentialIcon(credential.kind)}
							size="15px"
							class="mt-0.5 shrink-0 text-amberprint"
						/>
						<span>{credential.text}</span>
					</li>
				))}
			</ul>
		)}

		{d.note && <p class="text-body-sm italic text-brand-700">{d.note}</p>}
	</div>

	<p class="mt-space-md border-t border-grid pt-2 text-right">
		<span class="arrow-link text-label-md!">
			{d.badgeTone === 'copper' ? 'Curricular Leadership' : 'Academic Faculty'}
			<Icon name="arrow_forward" size="14px" />
		</span>
	</p>
</article>
