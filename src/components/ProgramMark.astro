---
import type { ImageMetadata } from 'astro';
import type { ProgramMarkName } from '../consts';
import architecture from '../assets/logos/architecture.webp';
import civil from '../assets/logos/civil.webp';
import computer from '../assets/logos/computer.webp';
import electronics from '../assets/logos/electronics.webp';

/*
 * A programme's mark: the College's own logo for that degree, in the circular
 * plate the design drew the badge into.
 *
 * These are the real marks, supplied in `logos/` and processed by
 * `scripts/build-logo-assets.mjs`. They replace an earlier set of drawn SVG
 * badges, which were geometry invented for the design and are no longer used
 * anywhere.
 *
 * They are raster on purpose. Tracing them was measured and rejected; the
 * numbers are in the build script. Only the electronics mark is flat line art
 * that survives binarisation, and the other three are tonal or photographic,
 * where a trace invents the greys and visibly degrades the College's own mark.
 *
 * `field` marks a logo drawn on a solid dark panel of its own. The Civil mark
 * is one: it has no alpha channel and its corners are #000000, which is part
 * of the artwork rather than an artefact of how it was saved. Left on a pale
 * plate it would read as a black square dropped onto the page, so it is always
 * given a dark plate. Because the panel and the artwork are both near-black,
 * the square's edge disappears and the plate reads as a disc.
 */
interface Props {
	mark: ProgramMarkName;
	/** The short form the design set inside the drawn badge, e.g. "PICE UIC". */
	label: string;
	/** The plate behind the mark, for whichever surface the caller sits on. */
	surface?: string;
}

const { mark, label, surface = 'bg-subtle' } = Astro.props;

const LOGOS: Record<ProgramMarkName, { src: ImageMetadata; field: boolean }> = {
	architecture: { src: architecture, field: false },
	civil: { src: civil, field: true },
	computer: { src: computer, field: false },
	electronics: { src: electronics, field: false },
};

const { src, field } = LOGOS[mark];
---

<span
	class:list={[
		'flex size-20 shrink-0 items-center justify-center rounded-full p-3',
		field ? 'bg-midnight' : surface,
	]}
>
	<img
		src={src.src}
		width={src.width}
		height={src.height}
		alt={`${label} logo`}
		loading="lazy"
		decoding="async"
		class="size-full object-contain"
	/>
</span>
