---
import type { ProgramMarkName } from '../consts';

/*
 * A programme's badge mark.
 *
 * The four marks are the prototype's own drawings, carried over geometry for
 * geometry: the dashed copper ring on Architecture and Electronics, the
 * rotated square on Civil, the pin-and-pad chip on Computer. Only the label face
 * changes — the prototype set it in Plus Jakarta Sans, which is not served here,
 * so it takes Atkinson like every other label on the site.
 *
 * The mark is drawn rather than loaded, so a programme has an identity without
 * shipping a bitmap.
 */
interface Props {
	mark: ProgramMarkName;
	/** The short form set inside the mark, e.g. "PICE UIC". */
	label: string;
}

const { mark, label } = Astro.props;

/** Ruled baseline for the label, which sits under the geometry in each mark. */
const LABEL_Y: Record<ProgramMarkName, number> = {
	architecture: 88,
	civil: 86,
	computer: 88,
	electronics: 88,
};

const LABEL_SIZE: Record<ProgramMarkName, number> = {
	architecture: 9,
	civil: 9,
	computer: 8.5,
	electronics: 8.5,
};
---

<svg
	viewBox="0 0 100 100"
	fill="none"
	stroke="currentColor"
	stroke-width="3"
	stroke-linejoin="round"
	class="w-full h-full text-navy"
	role="img"
	aria-label={`${label} mark`}
>
	{mark === 'architecture' && (
		<Fragment>
			<circle cx="50" cy="50" r="46" stroke="var(--color-copper)" stroke-dasharray="4 2" />
			<polygon points="50,15 82,75 18,75" />
			<line x1="50" y1="15" x2="50" y2="75" stroke-width="2" />
			<line x1="34" y1="45" x2="66" y2="45" stroke-width="2" />
		</Fragment>
	)}

	{mark === 'civil' && (
		<Fragment>
			<rect
				x="18"
				y="18"
				width="64"
				height="64"
				transform="rotate(45 50 50)"
				stroke="var(--color-amberprint)"
			/>
			<path d="M30 65 L50 35 L70 65" />
			<path d="M38 52 L62 52" stroke-width="2" />
		</Fragment>
	)}

	{mark === 'computer' && (
		<Fragment>
			<circle cx="50" cy="50" r="44" stroke="var(--color-brand-300)" />
			<rect x="36" y="36" width="28" height="28" rx="3" stroke-width="2.5" />
			<line x1="28" y1="42" x2="36" y2="42" stroke-width="2" />
			<line x1="28" y1="50" x2="36" y2="50" stroke-width="2" />
			<line x1="28" y1="58" x2="36" y2="58" stroke-width="2" />
			<line x1="64" y1="42" x2="72" y2="42" stroke-width="2" />
			<line x1="64" y1="50" x2="72" y2="50" stroke-width="2" />
			<line x1="64" y1="58" x2="72" y2="58" stroke-width="2" />
			<line x1="42" y1="28" x2="42" y2="36" stroke-width="2" />
			<line x1="58" y1="28" x2="58" y2="36" stroke-width="2" />
			<line x1="42" y1="64" x2="42" y2="72" stroke-width="2" />
			<line x1="58" y1="64" x2="58" y2="72" stroke-width="2" />
		</Fragment>
	)}

	{mark === 'electronics' && (
		<Fragment>
			<circle cx="50" cy="50" r="44" stroke="var(--color-copper)" stroke-dasharray="3 3" />
			<polygon points="52,18 36,48 50,48 44,80 64,44 50,44" stroke-width="2.5" />
			<circle cx="50" cy="50" r="8" stroke-width="1.5" />
		</Fragment>
	)}

	<text
		x="50"
		y={LABEL_Y[mark]}
		text-anchor="middle"
		fill="currentColor"
		stroke="none"
		font-family="var(--font-sans)"
		font-size={LABEL_SIZE[mark]}
		font-weight="700"
		letter-spacing="0.02em"
	>
		{label}
	</text>
</svg>
