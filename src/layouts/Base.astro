---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Absolute or root-relative path to the social sharing image. */
	image?: string;
	/** JSON-LD graph nodes for this page. */
	schema?: object[];
	/** Hide the site header and footer, for full-bleed pages. */
	bare?: boolean;
}

const { title, description = SITE_DESCRIPTION, image, schema = [], bare = false } = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_NAME}`;

/*
 * `site` is set in astro.config.mjs and is the only thing that should ever
 * decide these. Falling back to a placeholder would put a wrong canonical URL
 * and a wrong sitemap on every page, so the fallback is loud rather than
 * silent: nothing is emitted at all when the build has no site configured.
 */
const origin = Astro.site;
const canonical = origin ? new URL(Astro.url.pathname, origin) : undefined;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical.href} />}
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical.href} />}
		{image && origin && <meta property="og:image" content={new URL(image, origin).href} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{origin && <link rel="sitemap" href="/sitemap-index.xml" />}

		{/*
			Applied before first paint so a dark-mode visitor never sees a white
			flash. Kept inline and synchronous on purpose; deferring it would
			defeat the whole point.
		*/}
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('cea-theme');
				const dark = stored
					? stored === 'dark'
					: matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
				// Signals to CSS that scripting works, so controls that need it can
				// safely start hidden and reveal-on-scroll can start elements hidden.
				document.documentElement.classList.add('js');
			})();
		</script>
		{schema.length > 0 && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify(schema.length === 1 ? schema[0] : { '@graph': schema })}
			/>
		)}

		<slot name="head" />
	</head>
	<body class="min-h-screen antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded focus:bg-navy focus:px-4 focus:py-2 focus:text-white"
		>
			Skip to content
		</a>

		{!bare && <Header />}

		<main id="main" class:list={[!bare && 'pt-space-header']}>
			<slot />
		</main>

		{!bare && <Footer />}

		<script>
			/*
			 * Reveal-on-scroll. The `js` class on <html> (set inline in the
			 * head) is what allows .reveal to start hidden, so a visitor
			 * without JS simply sees the finished page — and so does one whose
			 * browser has no IntersectionObserver, rather than a page that
			 * waits for an observer that will never arrive.
			 */
			const targets = document.querySelectorAll<HTMLElement>('.reveal');

			if (targets.length > 0) {
				// Stagger siblings so a grid animates in as a wave rather than
				// all at once.
				targets.forEach((el, i) => {
					el.style.transitionDelay = `${Math.min(i % 6, 5) * 70}ms`;
				});

				if (
					!matchMedia('(prefers-reduced-motion: reduce)').matches &&
					typeof IntersectionObserver === 'function'
				) {
					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-visible');
									observer.unobserve(entry.target);
								}
							}
						},
						{ rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
					);
					targets.forEach((el) => observer.observe(el));
				} else {
					targets.forEach((el) => el.classList.add('is-visible'));
				}
			}
		</script>
	</body>
</html>
